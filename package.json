{
  "name": "milo-design-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @milo/kit",
    "build": "npm run build -w @milo/kit",
    "typecheck": "tsc -b",
    "props": "npm run props -w @milo/ui",
    "mascotas": "python3 apps/kit/scripts/mascotas.py",
    "picos": "python3 apps/kit/scripts/picos.py",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^7.0.6",
    "vitest": "^5.0.0"
  }
}
